        <field name="story_points" eval="5"/>
        <field name="user_ids" eval="[(6, 0, [ref('user_ava')])]"/>
        <field name="state">1_done</field>
    </record>

    <record id="task_data_schema" model="project.task">
        <field name="name">Data warehouse schema review</field>
        <field name="project_id" ref="project.project_project_2"/>
        <field name="sprint_id" ref="sprint_data_2"/>
        <field name="story_points" eval="3"/>
        <field name="user_ids" eval="[(6, 0, [ref('user_ava')])]"/>
    </record>

