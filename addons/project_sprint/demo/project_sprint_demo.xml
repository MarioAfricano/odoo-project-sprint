    <!-- ============================================================ -->
    <!-- START THE ACTIVE SPRINTS                                     -->
    <!-- Called after the tasks exist, so committed points are real.  -->
    <!-- ============================================================ -->

    <function model="project.sprint" name="action_start"
              eval="[[ref('sprint_platform_5'), ref('sprint_mobile_3'), ref('sprint_data_2')]]"/>

