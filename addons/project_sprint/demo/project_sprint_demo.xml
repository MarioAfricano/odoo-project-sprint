        <field name="name">Single sign-on integration</field>
        <field name="project_id" ref="project.project_project_2"/>
        <field name="sprint_id" ref="sprint_platform_5"/>
        <field name="story_points" eval="5"/>
        <field name="user_ids" eval="[(6, 0, [ref('base.user_demo')])]"/>
        <field name="state">1_done</field>
    </record>

    <record id="task_platform_cache" model="project.task">
        <field name="name">Add caching layer to reports</field>
        <field name="project_id" ref="project.project_project_1"/>
        <field name="sprint_id" ref="sprint_platform_5"/>
        <field name="story_points" eval="5"/>
        <field name="user_ids" eval="[(6, 0, [ref('base.user_admin')])]"/>
    </record>

    <record id="task_platform_ci" model="project.task">
        <field name="name">Set up CI pipeline for the client portal</field>
        <field name="project_id" ref="project.project_project_3"/>
        <field name="sprint_id" ref="sprint_platform_5"/>
        <field name="story_points" eval="3"/>
        <field name="user_ids" eval="[(6, 0, [ref('base.user_demo')])]"/>
    </record>

    <!-- Assigned to Andrew (Mobile Team): shows up as a borrowed member -->
    <record id="task_platform_push" model="project.task">
        <field name="name">Push notification endpoint</field>
        <field name="project_id" ref="project.project_project_2"/>
        <field name="sprint_id" ref="sprint_platform_5"/>
        <field name="story_points" eval="3"/>
        <field name="user_ids" eval="[(6, 0, [ref('user_andrew')])]"/>
    </record>

