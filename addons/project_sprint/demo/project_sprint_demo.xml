    <record id="task_mobile_offline" model="project.task">
        <field name="name">Offline mode for the field app</field>
        <field name="project_id" ref="project.project_project_3"/>
        <field name="sprint_id" ref="sprint_mobile_3"/>
        <field name="story_points" eval="8"/>
        <field name="user_ids" eval="[(6, 0, [ref('user_andrew')])]"/>
        <field name="state">1_done</field>
    </record>

    <record id="task_mobile_dark_mode" model="project.task">
        <field name="name">Dark mode</field>
        <field name="project_id" ref="project.project_project_4"/>
        <field name="sprint_id" ref="sprint_mobile_3"/>
        <field name="story_points" eval="3"/>
