<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- USERS                                                        -->
    <!-- ============================================================ -->

    <record id="user_andrew" model="res.users">
        <field name="name">Andrew Andrews</field>
        <field name="login">andrew.demo</field>
        <field name="groups_id" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="user_ava" model="res.users">
        <field name="name">Ava Alice</field>
        <field name="login">ava.demo</field>
        <field name="groups_id" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- TEAMS                                                        -->
    <!-- ============================================================ -->

    <record id="team_platform" model="project.team">
        <field name="name">Platform Team</field>
        <field name="member_ids" eval="[(6, 0, [ref('base.user_admin'), ref('base.user_demo')])]"/>
    </record>

    <record id="team_mobile" model="project.team">
        <field name="name">Mobile Team</field>
        <field name="member_ids" eval="[(6, 0, [ref('user_andrew')])]"/>
    </record>

    <record id="team_data" model="project.team">
        <field name="name">Data Team</field>
        <field name="member_ids" eval="[(6, 0, [ref('user_ava')])]"/>
    </record>

    <!-- ============================================================ -->
    <!-- PLATFORM TEAM SPRINTS                                        -->
    <!-- ============================================================ -->

    <record id="sprint_platform_1" model="project.sprint">
        <field name="name">Platform Team - Sprint 1</field>
        <field name="team_id" ref="team_platform"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(weeks=8)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() - relativedelta(weeks=6, days=1)).strftime('%Y-%m-%d')"/>
        <field name="state">done</field>
        <field name="committed_points" eval="20"/>
        <field name="delivered_points" eval="16"/>
    </record>

    <record id="sprint_platform_2" model="project.sprint">
        <field name="name">Platform Team - Sprint 2</field>
        <field name="team_id" ref="team_platform"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(weeks=6)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() - relativedelta(weeks=4, days=1)).strftime('%Y-%m-%d')"/>
        <field name="state">done</field>
        <field name="committed_points" eval="22"/>
        <field name="delivered_points" eval="21"/>
    </record>

    <record id="sprint_platform_3" model="project.sprint">
        <field name="name">Platform Team - Sprint 3</field>
        <field name="team_id" ref="team_platform"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(weeks=4)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() - relativedelta(weeks=2, days=1)).strftime('%Y-%m-%d')"/>
        <field name="state">done</field>
        <field name="committed_points" eval="24"/>
        <field name="delivered_points" eval="19"/>
    </record>

    <record id="sprint_platform_4" model="project.sprint">
        <field name="name">Platform Team - Sprint 4</field>
        <field name="team_id" ref="team_platform"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(weeks=2)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() - relativedelta(days=1)).strftime('%Y-%m-%d')"/>
        <field name="state">done</field>
        <field name="committed_points" eval="21"/>
        <field name="delivered_points" eval="21"/>
    </record>

    <record id="sprint_platform_5" model="project.sprint">
        <field name="name">Platform Team - Sprint 5</field>
        <field name="team_id" ref="team_platform"/>
        <field name="date_start" eval="DateTime.today().strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() + relativedelta(weeks=2, days=-1)).strftime('%Y-%m-%d')"/>
        <field name="goal">Launch the public API for the client portal.</field>
    </record>

    <record id="sprint_platform_6" model="project.sprint">
        <field name="name">Platform Team - Sprint 6</field>
        <field name="team_id" ref="team_platform"/>
        <field name="date_start" eval="(DateTime.today() + relativedelta(weeks=2)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() + relativedelta(weeks=4, days=-1)).strftime('%Y-%m-%d')"/>
    </record>

    <!-- ============================================================ -->
    <!-- MOBILE TEAM SPRINTS                                          -->
    <!-- ============================================================ -->

    <record id="sprint_mobile_1" model="project.sprint">
        <field name="name">Mobile Team - Sprint 1</field>
        <field name="team_id" ref="team_mobile"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(weeks=4)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() - relativedelta(weeks=2, days=1)).strftime('%Y-%m-%d')"/>
        <field name="state">done</field>
        <field name="committed_points" eval="18"/>
        <field name="delivered_points" eval="15"/>
    </record>

    <record id="sprint_mobile_2" model="project.sprint">
        <field name="name">Mobile Team - Sprint 2</field>
        <field name="team_id" ref="team_mobile"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(weeks=2)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() - relativedelta(days=1)).strftime('%Y-%m-%d')"/>
        <field name="state">done</field>
        <field name="committed_points" eval="20"/>
        <field name="delivered_points" eval="20"/>
    </record>

    <record id="sprint_mobile_3" model="project.sprint">
        <field name="name">Mobile Team - Sprint 3</field>
        <field name="team_id" ref="team_mobile"/>
        <field name="date_start" eval="DateTime.today().strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() + relativedelta(weeks=2, days=-1)).strftime('%Y-%m-%d')"/>
        <field name="goal">Ship offline mode to the field app beta testers.</field>
    </record>

    <!-- ============================================================ -->
    <!-- DATA TEAM SPRINTS                                            -->
    <!-- ============================================================ -->

    <record id="sprint_data_1" model="project.sprint">
        <field name="name">Data Team - Sprint 1</field>
        <field name="team_id" ref="team_data"/>
        <field name="date_start" eval="(DateTime.today() - relativedelta(weeks=2)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() - relativedelta(days=1)).strftime('%Y-%m-%d')"/>
        <field name="state">done</field>
        <field name="committed_points" eval="12"/>
        <field name="delivered_points" eval="9"/>
    </record>

    <record id="sprint_data_2" model="project.sprint">
        <field name="name">Data Team - Sprint 2</field>
        <field name="team_id" ref="team_data"/>
        <field name="date_start" eval="DateTime.today().strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() + relativedelta(weeks=2, days=-1)).strftime('%Y-%m-%d')"/>
        <field name="goal">Deliver the first version of the sales dashboard.</field>
    </record>

    <!-- ============================================================ -->
    <!-- TASKS - PLATFORM TEAM, SPRINT 4 (done, 21 points delivered)  -->
    <!-- ============================================================ -->

    <record id="task_platform_search" model="project.task">
        <field name="name">Search indexing</field>
        <field name="project_id" ref="project.project_project_2"/>
        <field name="sprint_id" ref="sprint_platform_4"/>
        <field name="story_points" eval="8"/>
        <field name="user_ids" eval="[(6, 0, [ref('base.user_admin')])]"/>
        <field name="state">1_done</field>
    </record>

    <record id="task_platform_email" model="project.task">
        <field name="name">Email templates</field>
        <field name="project_id" ref="project.project_project_1"/>
        <field name="sprint_id" ref="sprint_platform_4"/>
        <field name="story_points" eval="5"/>
        <field name="user_ids" eval="[(6, 0, [ref('base.user_demo')])]"/>
        <field name="state">1_done</field>
    </record>

