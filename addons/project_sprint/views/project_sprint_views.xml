<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_sprint_view_list" model="ir.ui.view">
        <field name="name">project.sprint.list</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <list decoration-bf="state == 'active'">
                <field name="name"/>
                <field name="team_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="task_count"/>
                <field name="points_done" optional="hide"/>
                <field name="points_total" optional="hide"/>
                <field name="progress" widget="progressbar" invisible="state == 'done'"/>
                <field name="committed_points" optional="show"/>
                <field name="delivered_points" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="project_sprint_view_form" model="ir.ui.view">
        <field name="name">project.sprint.form</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start Sprint" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Close Sprint" type="object"
                            class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_create_next_sprint" string="Create Next Sprint" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'active')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="team_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="progress" widget="progressbar" invisible="state == 'done'"/>
                            <field name="committed_points" invisible="state == 'draft'"/>
                            <field name="delivered_points" invisible="state != 'done'"/>
                        </group>
                    </group>
                    <field name="goal" placeholder="What does the team want to achieve in this sprint?"/>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="story_points" sum="Total"/>
                                    <field name="stage_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Members" name="members">
                            <group>
                                <field name="member_ids" widget="many2many_avatar_user"/>
                                <field name="borrowed_member_ids" widget="many2many_avatar_user"/>
                            </group>
                        </page>
                        <page string="Carried Over" name="carried_over">
                            <field name="carried_over_task_ids">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="sprint_id" string="Moved To"/>
                                    <field name="story_points"/>
                                    <field name="stage_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_sprint_view_search" model="ir.ui.view">
        <field name="name">project.sprint.search</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="team_id"/>
                <filter string="My Teams" name="my_teams"
                        domain="[('team_id.member_ids', 'in', uid)]"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Planned" name="filter_planned" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Team" name="group_by_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="project_sprint_view_graph" model="ir.ui.view">
        <field name="name">project.sprint.graph</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <graph string="Sprint Velocity" type="bar">
                <field name="date_start" interval="week"/>
                <field name="team_id"/>
                <field name="delivered_points" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="project_sprint_view_pivot" model="ir.ui.view">
        <field name="name">project.sprint.pivot</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <pivot string="Sprint Velocity">
                <field name="team_id" type="row"/>
                <field name="name" type="row"/>
                <field name="committed_points" type="measure"/>
                <field name="delivered_points" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="project_sprint_action" model="ir.actions.act_window">
        <field name="name">Sprints</field>
        <field name="res_model">project.sprint</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_teams': 1, 'search_default_filter_active': 1, 'search_default_filter_planned': 1}</field>
    </record>

    <record id="project_sprint_action_velocity" model="ir.actions.act_window">
        <field name="name">Sprint Velocity</field>
        <field name="res_model">project.sprint</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="context">{'search_default_my_teams': 1}</field>
    </record>

</odoo>